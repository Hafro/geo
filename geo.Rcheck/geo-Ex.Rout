> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: d2ir
> ### Title: Convert between Geographic Coordinates and ICES Rectangles
> ### Aliases: d2ir ir2d
> ### Keywords: arith manip
> 
> ### ** Examples
> 
> 
> d2ir(54.25, 3.5)
[1] "37F3"
> d2ir(c(50,60), c(-20,-10))
[1] "29D0" "49E0"
> 
> ir2d(d2ir(54, 3))
    lat lon
1 54.25 3.5
> ## center positions for bottom left and approx top right rects
> ir2d("01A0")
    lat   lon
1 36.25 -43.5
> ir2d("99M7")
    lat  lon
1 85.25 67.5
> ir2d(c("01A0","99M7"))
    lat   lon
1 36.25 -43.5
2 85.25  67.5
> ## note that ICES CM1977/Gen:3 indicates half-size rects on eastern margin!
> 
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("d2ir", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
