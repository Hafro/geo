> ##D        The Function is trivially defined as
> ##D        function(lat, lon = NULL, ind)
> ##D        {
> ##D                       if(is.null(lon)) {
> ##D                            lon <- lat$lon
> ##D                            lat <- lat$lat
> ##D                       }
> ##D                       lat <- lat[ind]
> ##D                       lon <- lon[ind]
> ##D                       return(lat, lon)
> ##D        }
