> nameEx("geolegend")
> ### * geolegend
> 
> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: geolegend
> ### Title: Put a legend on a plot in the geo series.
> ### Aliases: geolegend
> 
> ### ** Examples
> 
> 
>            # The function is currently defined as
>        function(pos, legend, ...)
+        {
+                       oldpar <- par()
+                       par(geopar$gpar)
+                       on.exit(par(oldpar))
+                       xx <- Proj(pos$lat, pos$lon)
+                       legend(xx$x, xx$y, legend = legend, ...)
+        }
function (pos, legend, ...) 
{
    oldpar <- par()
    par(geopar$gpar)
    on.exit(par(oldpar))
    xx <- Proj(pos$lat, pos$lon)
    legend(xx$x, xx$y, legend = legend, ...)
}
> 
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("geolegend", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
